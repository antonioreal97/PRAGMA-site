{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/studio/:path*", "destination": "/studio.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
